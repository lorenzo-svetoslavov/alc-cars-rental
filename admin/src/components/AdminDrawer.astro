---
const pathname = Astro.url.pathname;
const user = Astro.locals.user;
const isAdmin = user?.role === "admin";
const isActive = (path: string) =>
    path === "/" ? pathname === "/" : pathname.startsWith(path);
---

<div class="drawer lg:drawer-open">
    <input id="admin-drawer" type="checkbox" class="drawer-toggle" />

    <div class="drawer-content flex flex-col h-screen overflow-y-auto">
        <!-- Navbar -->
        <div class="navbar bg-orange-600 border-b border-orange-700 lg:hidden">
            <div class="flex-none">
                <label
                    for="admin-drawer"
                    aria-label="Abrir menú"
                    class="btn btn-square btn-ghost drawer-button text-white"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="1.5" class="size-6" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"/></svg>
                </label>
            </div>
            <div class="flex-1">
                <a href="/" class="text-lg font-bold text-white">ALC Cars</a>
            </div>
        </div>

        <!-- Page content -->
        <slot />
    </div>

    <div class="drawer-side z-40">
        <label
            for="admin-drawer"
            aria-label="Cerrar menú"
            class="drawer-overlay"
        ></label>

        <aside class="bg-orange-600 min-h-full w-72 border-r border-orange-700 flex flex-col">
            <!-- Logo -->
            <div class="p-5 pb-4 border-b border-orange-500/40">
                <a href="/" class="text-xl font-bold text-white">ALC Cars</a>
                <p class="text-xs text-orange-100 mt-1">Panel de administración</p>
            </div>

            <!-- Navigation -->
            <nav class="flex flex-col gap-1 p-4 flex-1">
                <a
                    href="/"
                    class:list={[
                        "flex items-center gap-4 px-4 py-3.5 rounded-xl text-sm font-medium transition-colors",
                        isActive("/")
                            ? "bg-white/20 text-white"
                            : "text-orange-100 hover:bg-white/10 hover:text-white",
                    ]}
                    onclick="document.getElementById('admin-drawer').checked=false"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="1.5" class="size-6 shrink-0" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955a1.126 1.126 0 0 1 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25"/></svg>
                    Panel
                </a>

                <a
                    href="/fleet"
                    class:list={[
                        "flex items-center gap-4 px-4 py-3.5 rounded-xl text-sm font-medium transition-colors",
                        isActive("/fleet")
                            ? "bg-white/20 text-white"
                            : "text-orange-100 hover:bg-white/10 hover:text-white",
                    ]}
                    aria-hidden={!isAdmin ? "true" : undefined}
                    style={!isAdmin ? "display:none" : undefined}
                    onclick="document.getElementById('admin-drawer').checked=false"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="1.5" class="size-6 shrink-0" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 0 1-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.9 17.9 0 0 0-3.213-9.193 2.06 2.06 0 0 0-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.6 48.6 0 0 0-10.026 0 1.106 1.106 0 0 0-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12"/></svg>
                    Flota
                </a>

                <a
                    href="/agenda"
                    class:list={[
                        "flex items-center gap-4 px-4 py-3.5 rounded-xl text-sm font-medium transition-colors",
                        isActive("/agenda")
                            ? "bg-white/20 text-white"
                            : "text-orange-100 hover:bg-white/10 hover:text-white",
                    ]}
                    onclick="document.getElementById('admin-drawer').checked=false"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="1.5" class="size-6 shrink-0" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5"/></svg>
                    Agenda
                </a>

                <a
                    href="/bookings"
                    class:list={[
                        "flex items-center gap-4 px-4 py-3.5 rounded-xl text-sm font-medium transition-colors",
                        isActive("/bookings")
                            ? "bg-white/20 text-white"
                            : "text-orange-100 hover:bg-white/10 hover:text-white",
                    ]}
                    onclick="document.getElementById('admin-drawer').checked=false"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="1.5" class="size-6 shrink-0" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 0 0 2.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 0 0-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75 2.25 2.25 0 0 0-.1-.664m-5.8 0A2.251 2.251 0 0 1 13.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25ZM6.75 12h.008v.008H6.75V12Zm0 3h.008v.008H6.75V15Zm0 3h.008v.008H6.75V18Z"/></svg>
                    Reservas
                </a>

                <a
                    href="/customers"
                    class:list={[
                        "flex items-center gap-4 px-4 py-3.5 rounded-xl text-sm font-medium transition-colors",
                        isActive("/customers")
                            ? "bg-white/20 text-white"
                            : "text-orange-100 hover:bg-white/10 hover:text-white",
                    ]}
                    aria-hidden={!isAdmin ? "true" : undefined}
                    style={!isAdmin ? "display:none" : undefined}
                    onclick="document.getElementById('admin-drawer').checked=false"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="1.5" class="size-6 shrink-0" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z"/></svg>
                    Clientes
                </a>

                {isAdmin && (
                    <a
                        href="/staff"
                        class:list={[
                            "flex items-center gap-4 px-4 py-3.5 rounded-xl text-sm font-medium transition-colors",
                            isActive("/staff")
                                ? "bg-white/20 text-white"
                                : "text-orange-100 hover:bg-white/10 hover:text-white",
                        ]}
                        onclick="document.getElementById('admin-drawer').checked=false"
                    >
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="1.5" class="size-6 shrink-0" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z"/></svg>
                        Equipo
                    </a>
                )}
            </nav>

            <!-- Footer -->
            <div class="p-4 border-t border-orange-500/40">
                {user && (
                    <div class="flex items-center gap-3 mb-3">
                        <div class="w-9 h-9 rounded-full bg-white/15 text-white flex items-center justify-center text-sm font-bold shrink-0">
                            {(user.name ?? user.email ?? "A").slice(0, 1).toUpperCase()}
                        </div>
                        <div class="min-w-0">
                            <p class="text-sm font-medium text-white truncate">{user.name ?? (isAdmin ? "Administrador" : "Trabajador")}</p>
                            <p class="text-xs text-orange-100 truncate">{user.email}</p>
                        </div>
                    </div>
                )}
                <div class="flex items-center justify-between gap-2">
                    <span class="text-xs text-orange-100">ALC Cars © {new Date().getFullYear()}</span>
                    <form method="post" action="/api/auth/signout">
                        <button type="submit" class="btn btn-xs btn-ghost text-orange-100 hover:text-white hover:bg-white/10">
                            Salir
                        </button>
                    </form>
                </div>
            </div>
        </aside>
    </div>
</div>
