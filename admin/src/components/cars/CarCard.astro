---
import { CAR_OPTIONS, type Car } from "@/types/car";

interface Props {
    car: Car;
}

const { car } = Astro.props;

const name = `${car.make} ${car.model} ${car.model_year}`;
const price = new Intl.NumberFormat("es-ES", {
    style: "currency",
    currency: "EUR",
}).format(car.daily_rate);
const mileage = new Intl.NumberFormat("es-ES").format(car.mileage);

const specs = [
    { label: "Plazas", value: car.seats },
    { label: "Puertas", value: car.doors },
    { label: "Aire acondicionado", value: car.air_conditioning ? "Sí" : "No" },
    { label: "Kilometraje", value: `${mileage} km` },
] as const;
---

<article
    class:list={[
        "card bg-base-100 border shadow-sm overflow-hidden flex flex-col",
        car.available
            ? "border-base-300"
            : "border-base-300",
    ]}
>
    <div class="relative">
        <img
            src={car.image_url}
            alt={name}
            loading="lazy"
            class="w-full aspect-[16/10] object-cover"
        />

        <span
            class:list={[
                "badge absolute top-3 right-3",
                car.available ? "badge-success" : "badge-error",
            ]}
        >
            {car.available ? "Disponible" : "No disponible"}
        </span>
    </div>

    <div class="flex flex-col flex-1 gap-3 p-4 sm:p-5">
        <div class="flex flex-wrap gap-2">
            <span class="badge badge-outline self-start capitalize">
                {CAR_OPTIONS.category[car.category]}
            </span>
            <span class="badge badge-outline self-start capitalize">
                {CAR_OPTIONS.transmission[car.transmission]}
            </span>
            <span class="badge badge-outline self-start capitalize">
                {CAR_OPTIONS.fuel[car.fuel]}
            </span>
        </div>

        <div class="flex items-start justify-between gap-3">
            <h3 class="text-base sm:text-lg font-bold leading-tight">{name}</h3>
            <p class="text-base sm:text-lg font-bold whitespace-nowrap">
                {price}
                <span class="text-xs font-normal text-slate-500"> /día</span>
            </p>
        </div>

        <p class="text-xs text-slate-500">
            Matrícula: <span class="font-medium text-slate-700">{car.plate_number}</span>
        </p>

        <dl class="grid grid-cols-2 gap-x-4 gap-y-2 text-sm border-t border-base-200 pt-3 mt-auto">
            {specs.map((spec) => (
                <div class="flex items-center justify-between gap-2">
                    <dt class="text-slate-500">{spec.label}</dt>
                    <dd class="font-medium text-slate-700 capitalize">{spec.value}</dd>
                </div>
            ))}
        </dl>
    </div>

    <div class="p-4 pt-0">
        <a href={`/fleet/${car.id}/edit`} class="btn btn-warning btn-sm w-full">
            Editar
        </a>
    </div>
</article>