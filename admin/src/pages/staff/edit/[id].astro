---
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
    deleteStaffMember,
    getStaffMemberById,
    updateStaffMember,
} from "@/lib/staff";
import type { StaffMember, StaffRole } from "@/types/staff";
import { hasAdminSession } from "@/lib/auth";

if (!hasAdminSession(Astro.locals)) {
    return Astro.redirect("/login");
}

const id = Astro.params.id;

let member: StaffMember | null = null;
let loadError: string | null = null;
let saveError: string | null = null;
let deleteError: string | null = null;
let formData: Record<string, string> = {};

const isSelf = !!id && id === Astro.locals.user?.id;

if (!id) {
    loadError = "ID de miembro no válido.";
} else {
    try {
        member = await getStaffMemberById(id);
    } catch (e) {
        loadError = e instanceof Error ? e.message : "Error inesperado";
    }
}

if (Astro.request.method === "POST" && member) {
    const form = await Astro.request.formData();
    const action = form.get("_action");

    if (action === "delete") {
        if (isSelf) {
            deleteError = "No puedes eliminar tu propio usuario.";
        } else {
            try {
                await deleteStaffMember(member.id);
                return Astro.redirect("/staff");
            } catch (e) {
                deleteError = e instanceof Error ? e.message : "Error inesperado";
            }
        }
    } else {
        formData = Object.fromEntries(form.entries()) as Record<string, string>;

        const first_name = (form.get("first_name") ?? "").toString().trim();
        const last_name = (form.get("last_name") ?? "").toString().trim();
        const role = (form.get("role") ?? "").toString() as StaffRole;

        if (!first_name) {
            saveError = "El nombre es obligatorio.";
        } else if (!last_name) {
            saveError = "Los apellidos son obligatorios.";
        } else if (role !== "admin" && role !== "worker") {
            saveError = "El rol no es válido.";
        } else {
            try {
                await updateStaffMember(member.id, {
                    first_name,
                    last_name,
                    role,
                });
                return Astro.redirect("/staff");
            } catch (e) {
                saveError = e instanceof Error ? e.message : "Error inesperado";
            }
        }
    }
}

const v = (name: string, fallback?: string | null) =>
    formData[name] ?? (fallback ?? "");
---

<BaseLayout title={`Editar miembro · ALC Cars`}>
    <div class="flex-1 max-w-3xl w-full mx-auto px-4 py-8 sm:py-12">
        <header class="mb-8 flex items-center justify-between">
            <div>
                <h1 class="text-3xl font-bold">Editar miembro del equipo</h1>
                <p class="text-slate-500 mt-1">
                    {member
                        ? `${member.first_name} ${member.last_name}${member.email ? ` (${member.email})` : ""}`
                        : ""}
                </p>
            </div>
            <a href="/staff" class="btn btn-ghost btn-sm">Volver</a>
        </header>

        {loadError || !member ? (
            <div class="alert alert-error" role="alert">
                <span>{loadError ?? "Miembro no encontrado."}</span>
            </div>
        ) : (
            <>
                {saveError && (
                    <div class="alert alert-error mb-6" role="alert">
                        <span>{saveError}</span>
                    </div>
                )}
                {deleteError && (
                    <div class="alert alert-error mb-6" role="alert">
                        <span>{deleteError}</span>
                    </div>
                )}
                <form method="post" class="card bg-base-100 border border-base-300 shadow-sm">
                    <div class="card-body gap-4">
                        <div class="grid gap-4 sm:grid-cols-2">
                            <label class="form-control">
                                <span class="label">Nombre *</span>
                                <input class="input input-bordered" type="text" name="first_name"
                                    value={v("first_name", member.first_name)} required />
                            </label>
                            <label class="form-control">
                                <span class="label">Apellidos *</span>
                                <input class="input input-bordered" type="text" name="last_name"
                                    value={v("last_name", member.last_name)} required />
                            </label>
                            <label class="form-control">
                                <span class="label">Rol *</span>
                                <select class="select select-bordered" name="role">
                                    <option value="worker" selected={member.role === "worker"}>
                                        Trabajador
                                    </option>
                                    <option value="admin" selected={member.role === "admin"}>
                                        Admin
                                    </option>
                                </select>
                            </label>
                            <div class="form-control">
                                <span class="label">Estado</span>
                                <p class="pt-2">
                                    {member.active ? (
                                        <span class="badge badge-success">Activo</span>
                                    ) : (
                                        <span class="badge badge-error">Inactivo</span>
                                    )}
                                </p>
                            </div>
                        </div>

                        <div class="flex justify-end gap-3 mt-2">
                            <a href="/staff" class="btn btn-ghost">Cancelar</a>
                            <button type="submit" class="btn btn-warning">Guardar cambios</button>
                        </div>
                    </div>
                </form>

                <div class="card bg-base-100 border border-error/30 shadow-sm mt-6">
                    <div class="card-body">
                        <h2 class="card-title text-error">Zona de peligro</h2>
                        <p class="text-slate-500">
                            {isSelf
                                ? "No puedes eliminar tu propia cuenta."
                                : "Eliminar este miembro borrará su cuenta de acceso. Se conservarán los datos de operativa existentes."}
                        </p>
                        <div class="card-actions justify-end">
                            <button
                                class="btn btn-error"
                                disabled={isSelf}
                                onclick="document.getElementById('delete-modal').showModal()"
                            >
                                Eliminar miembro
                            </button>
                        </div>
                    </div>
                </div>

                <dialog id="delete-modal" class="modal">
                    <div class="modal-box">
                        <h3 class="font-bold text-lg">Confirmar eliminación</h3>
                        <p class="py-4">
                            ¿Estás seguro de que quieres eliminar a
                            <strong>{member.first_name} {member.last_name}</strong>
                            {member.email && <> (<strong>{member.email}</strong>)</>}?
                            Su cuenta de acceso se eliminará de forma permanente.
                        </p>
                        <div class="modal-action">
                            <form method="dialog">
                                <button class="btn btn-ghost">Cancelar</button>
                            </form>
                            <form method="post">
                                <input type="hidden" name="_action" value="delete" />
                                <button type="submit" class="btn btn-error">Sí, eliminar</button>
                            </form>
                        </div>
                    </div>
                    <form method="dialog" class="modal-backdrop">
                        <button>close</button>
                    </form>
                </dialog>
            </>
        )}
    </div>
</BaseLayout>