---
import CarCard from "@/components/cars/CarCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCars } from "@/lib/cars";

let cars: Awaited<ReturnType<typeof getCars>> = [];
let error: string | null = null;

try {
    cars = await getCars();
} catch (e) {
    error = e instanceof Error ? e.message : "Error inesperado";
}
---

<BaseLayout title="Flota · ALC Cars">
    <div class="flex-1 max-w-7xl w-full mx-auto px-4 py-8 sm:py-12">
        <header class="mb-8 flex items-start justify-between gap-4">
            <div>
                <h1 class="text-3xl font-bold">Flota</h1>
                <p class="text-slate-500 mt-1">
                    {error
                        ? "No se pudo cargar la flota"
                        : `${cars.length} vehículo${cars.length === 1 ? "" : "s"}`}
                </p>
            </div>
            <a
                href="/fleet/new"
                class="btn btn-warning btn-sm gap-1"
            >
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                    <path d="M12 5v14M5 12h14" />
                </svg>
                Nuevo vehículo
            </a>
        </header>

        {error ? (
            <div class="alert alert-error" role="alert">
                <span>{error}</span>
            </div>
        ) : cars.length === 0 ? (
            <p class="text-slate-500 text-center py-12">
                No hay vehículos en la flota.
            </p>
        ) : (
            <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
                {cars.map((car) => <CarCard car={car} />)}
            </div>
        )}
    </div>
</BaseLayout>