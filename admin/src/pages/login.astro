---
import "../styles/global.css";

if (Astro.locals.user) {
    return Astro.redirect("/");
}

const errorParam = Astro.url.searchParams.get("error");

const ERROR_MESSAGES: Record<string, string> = {
    invalid: "Email o contraseña incorrectos.",
    forbidden: "Esta cuenta no tiene permisos de administrador.",
    missing: "Introduce email y contraseña.",
};
---


<!doctype html>
<html lang="es" data-theme="light">
    <head>
        <meta charset="UTF-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Iniciar sesión · ALC Cars</title>
    </head>
    <body class="min-h-screen bg-orange-600 flex items-center justify-center p-4">
        <div class="fixed inset-0 pointer-events-none bg-gradient-to-br from-orange-400 via-orange-600 to-orange-800"></div>
        <main class="relative card w-full max-w-sm bg-white/95 backdrop-blur shadow-2xl shadow-orange-950/30 border-0">
            <div class="card-body gap-6">
                <div class="text-center">
                    <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-orange-500 to-orange-700 flex items-center justify-center mx-auto mb-4 shadow-lg shadow-orange-600/40">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="1.5" class="size-8 text-white" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 0 1-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.9 17.9 0 0 0-3.213-9.193 2.06 2.06 0 0 0-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.6 48.6 0 0 0-10.026 0 1.106 1.106 0 0 0-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12"/></svg>
                    </div>
                    <h1 class="text-2xl font-bold text-slate-900">ALC Cars</h1>
                    <p class="text-slate-600 mt-1 text-sm">Panel de administración</p>
                </div>

                {errorParam && ERROR_MESSAGES[errorParam] && (
                    <div class="alert alert-error py-2.5" role="alert">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" /></svg>
                        <span class="text-sm">{ERROR_MESSAGES[errorParam]}</span>
                    </div>
                )}

                <form method="post" action="/api/auth/signin" class="flex flex-col gap-4">
                    <label class="form-control">
                        <span class="label">Email</span>
                        <input
                            class="input input-bordered focus:outline-none focus:border-orange-500 focus:ring-2 focus:ring-orange-500/30"
                            type="email"
                            name="email"
                            placeholder="admin@alc-cars.com"
                            autocomplete="username"
                            required
                        />
                    </label>
                    <label class="form-control">
                        <span class="label">Contraseña</span>
                        <input
                            class="input input-bordered focus:outline-none focus:border-orange-500 focus:ring-2 focus:ring-orange-500/30"
                            type="password"
                            name="password"
                            placeholder="••••••••"
                            autocomplete="current-password"
                            required
                        />
                    </label>
                    <button type="submit" class="btn mt-2 bg-orange-600 border-0 text-white hover:bg-orange-700 shadow-lg shadow-orange-600/30">
                        Iniciar sesión
                    </button>
                </form>
            </div>
        </main>
    </body>
</html>