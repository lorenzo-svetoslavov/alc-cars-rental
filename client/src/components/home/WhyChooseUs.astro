---
const features = [
    {
        title: "Free cancellation",
        text: "Change your plans with no penalty.",
        icon: "calendar",
    },
    {
        title: "24/7 customer support",
        text: "We help you at any time.",
        icon: "headset",
    },
    {
        title: "Fast pickup",
        text: "Less than 10 minutes and you're on the road.",
        icon: "clock",
    },
    {
        title: "Best price guaranteed",
        text: "If you find it cheaper, we'll match it.",
        icon: "tag",
    },
];
---

<section class="bg-slate-50 py-16 px-4">
    <div class="max-w-6xl mx-auto">
        <h2
            class="text-3xl md:text-4xl font-bold text-center mb-4"
        >
            Travel with total peace of mind
        </h2>
        <p class="text-center max-w-xl mx-auto mb-12">
            Enjoy the road without worries. Our protection services are designed
            for your complete peace of mind.
        </p>

        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
            {
                features.map((feature) => (
                    <article class="bg-white rounded-2xl border border-slate-100 shadow-sm p-8 text-center">
                        <div class="w-12 h-12 mx-auto mb-5 rounded-full bg-orange-50 flex items-center justify-center text-orange-500">
                            <svg
                                class="w-6 h-6"
                                xmlns="http://www.w3.org/2000/svg"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                                stroke-width="1.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                {feature.icon === "shield" && (
                                    <path d="M12 3l7 3v5c0 4.5-3 8.3-7 10-4-1.7-7-5.5-7-10V6l7-3z" />
                                )}
                                {feature.icon === "infinity" && (
                                    <path d="M6.5 8.5a3.5 3.5 0 100 7c1.4 0 2.4-.8 3.3-1.8L12 12l2.2-1.7c.9-1 1.9-1.8 3.3-1.8a3.5 3.5 0 110 7c-1.4 0-2.4-.8-3.3-1.8L12 12l-2.2 1.7c-.9 1-1.9 1.8-3.3 1.8z" />
                                )}
                                {feature.icon === "calendar" && (
                                    <>
                                        <rect
                                            x="3.5"
                                            y="5"
                                            width="17"
                                            height="15"
                                            rx="2.5"
                                        />
                                        <path d="M3.5 9.5h17M8 3.5v3M16 3.5v3" />
                                    </>
                                )}
                                {feature.icon === "headset" && (
                                    <>
                                        <path d="M4.5 13v-1a7.5 7.5 0 1115 0v1" />
                                        <path d="M19.5 13v3a3.5 3.5 0 01-3.5 3.5h-2" />
                                        <rect
                                            x="2.5"
                                            y="12.5"
                                            width="3.5"
                                            height="5"
                                            rx="1.5"
                                        />
                                        <rect
                                            x="18"
                                            y="12.5"
                                            width="3.5"
                                            height="5"
                                            rx="1.5"
                                        />
                                    </>
                                )}
                                {feature.icon === "clock" && (
                                    <>
                                        <circle cx="12" cy="12" r="8.5" />
                                        <path d="M12 7.5V12l3 1.8" />
                                    </>
                                )}
                                {feature.icon === "tag" && (
                                    <>
                                        <path d="M11.2 3.5H20v8.8l-8.7 8.7a1.5 1.5 0 01-2.1 0l-6.7-6.7a1.5 1.5 0 010-2.1l8.7-8.7z" />
                                        <circle cx="16.2" cy="7.8" r="1.3" />
                                    </>
                                )}
                            </svg>
                        </div>

                        <h3 class="text-lg font-bold mb-2">
                            {feature.title}
                        </h3>
                        <p class="text-sm text-orange-500">{feature.text}</p>
                    </article>
                ))
            }
        </div>
    </div>
</section>
