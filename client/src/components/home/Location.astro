---
const location = {
    name: "Alicante-Elche Airport (ALC)",
    address: "Salidas - Departures, 03195, Eixides, 03195 L'Altet, Alicante",
    pickup: "2-minute shuttle from terminal",
    phone: "+34 965 123 456",
    hours: "06:00 - 23:55",
    mapsQuery: "Alicante-Elche+Airport+Car+Rental",
};

const details = [
    { title: "Address", text: location.address, icon: "pin" },
    { title: "Contact", text: location.phone, icon: "phone" },
];
---

<section class="bg-slate-50 py-16 px-4">
    <div class="max-w-6xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold text-center">
            Pick up your car at Alicante-Elche Airport
        </h2>
        <p class="mt-4 max-w-xl mx-auto text-center text-slate-500">
            Your car is waiting just minutes from the terminal. Quick pickup,
            same-spot returns, and no stress.
        </p>

        <div class="mt-10 grid gap-6 lg:grid-cols-2 lg:items-stretch">
            <div
                class="overflow-hidden rounded-2xl border border-slate-100 shadow-sm min-h-80 lg:min-h-104"
            >
                <iframe
                    class="w-full h-full min-h-80 lg:min-h-104"
                    src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d6263.308787915822!2d-0.5555298236576063!3d38.28750358245906!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd624a1a4da6fcbb%3A0x23206dc85def3ffb!2s%5BP%5D%20ALC%20Valet%20Parking%20Alicante!5e0!3m2!1ses!2ses!4v1786873479885!5m2!1ses!2ses"
                    title={`Map of ${location.name}`}
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                    style="border:0;"
                    allowfullscreen></iframe>
            </div>

            <div
                class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6 sm:p-8 flex flex-col gap-4"
            >
                <div
                    class="rounded-xl bg-slate-50 border-l-4 border-orange-500 p-5"
                >
                    <div class="flex items-center gap-2">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            fill="none"
                            stroke="currentColor"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="1.5"
                            class="w-5 h-5 text-orange-500"
                            viewBox="0 0 24 24"
                            ><circle cx="12" cy="12" r="8.5"></circle><path
                                d="M12 7.5V12l3 1.8"></path></svg
                        >
                        <h3 class="text-lg font-bold">Opening Hours</h3>
                    </div>
                    <p class="mt-2 text-sm text-slate-500">
                        Monday to Sunday: <span
                            class="font-bold text-orange-500"
                            >{location.hours}</span
                        >
                    </p>
                </div>

                <div class="grid gap-4 sm:grid-cols-2">
                    {
                        details.map((detail) => (
                            <article class="rounded-xl bg-slate-50 p-5">
                                <div class="flex items-center gap-2">
                                    <svg
                                        class="w-5 h-5 text-orange-500"
                                        xmlns="http://www.w3.org/2000/svg"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke="currentColor"
                                        stroke-width="1.5"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                    >
                                        {detail.icon === "pin" && (
                                            <>
                                                <path d="M12 21c4-4.4 6-7.7 6-10a6 6 0 10-12 0c0 2.3 2 5.6 6 10z" />
                                                <circle
                                                    cx="12"
                                                    cy="11"
                                                    r="2.2"
                                                />
                                            </>
                                        )}
                                        {detail.icon === "car" && (
                                            <>
                                                <path d="M4 16.5v2a1 1 0 001 1h1.5a1 1 0 001-1v-1M16.5 17.5v1a1 1 0 001 1H19a1 1 0 001-1v-2" />
                                                <path d="M4 16.5h16v-4l-1.6-4a2 2 0 00-1.9-1.4H7.5A2 2 0 005.6 8.5L4 12.5v4z" />
                                                <path d="M7 14.5h.01M17 14.5h.01" />
                                            </>
                                        )}
                                        {detail.icon === "phone" && (
                                            <path d="M6.6 10.8a15 15 0 006.6 6.6l2.2-2.2a1 1 0 011-.2c1.1.3 2.3.5 3.6.5a1 1 0 011 1V20a1 1 0 01-1 1C10.4 21 3 13.6 3 4.5a1 1 0 011-1h3.5a1 1 0 011 1c0 1.2.2 2.4.5 3.6a1 1 0 01-.2 1l-2.2 2.2z" />
                                        )}
                                    </svg>
                                    <h3 class="text-sm font-bold uppercase">
                                        {detail.title}
                                    </h3>
                                </div>
                                <p class="mt-2 text-sm text-slate-500">
                                    {detail.text}
                                </p>
                            </article>
                        ))
                    }
                </div>

                <div class="mt-auto pt-2 flex flex-wrap items-center gap-4">
                    <a
                        href="#booking"
                        class="btn rounded-lg bg-orange-500 hover:bg-orange-600 text-white border-none shadow-none px-6"
                    >
                        Book Now
                        <svg
                            class="w-4 h-4"
                            xmlns="http://www.w3.org/2000/svg"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <path d="M4 12h15M13 6l6 6-6 6"></path>
                        </svg>
                    </a>

                    <a
                        href={`https://www.google.com/maps/search/?api=1&query=${location.mapsQuery}`}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-2 text-sm text-slate-500 hover:text-orange-500"
                    >
                        Get directions
                        <svg
                            class="w-4 h-4"
                            xmlns="http://www.w3.org/2000/svg"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            stroke-width="1.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <path d="M14 4h6v6M20 4l-8 8"></path>
                            <path
                                d="M18 14v5a1.5 1.5 0 01-1.5 1.5H5A1.5 1.5 0 013.5 19V7.5A1.5 1.5 0 015 6h5"
                            ></path>
                        </svg>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
