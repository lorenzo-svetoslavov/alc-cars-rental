---
import type { CarSummary } from "@/types/car";

interface Props {
    car: CarSummary;
    /** When false, selecting a car asks for the dates instead of opening it */
    hasDates?: boolean;
    pickupAt?: string;
    returnAt?: string;
}

const { car, hasDates = true, pickupAt = "", returnAt = "" } = Astro.props;

const {
    id,
    make,
    model,
    model_year,
    transmission,
    fuel,
    seats,
    doors,
    air_conditioning,
    daily_rate,
    available,
    image_url,
} = car;

const extrasUrl = `/reserva/extras?car=${id}&pickup=${encodeURIComponent(pickupAt)}&return=${encodeURIComponent(returnAt)}`;

const name = `${make} ${model} ${model_year}`;

const selectClass =
    "btn bg-orange-500 hover:bg-orange-600 text-white border-none shadow-none mt-auto";
---

<article
    class:list={[
        "rounded-2xl border shadow-sm overflow-hidden flex flex-col",
        available
            ? "bg-white border-slate-100"
            : "bg-slate-100 border-slate-200 grayscale opacity-75",
    ]}
>
    <div class="relative">
        <img
            src={image_url}
            alt={name}
            loading="lazy"
            class="w-full h-48 object-cover"
        />
    </div>

    <div class="p-5 flex flex-col flex-1">
        <div class="flex items-start justify-between gap-3 mb-4">
            <h3 class="text-lg font-bold">{name}</h3>
            <p class="text-orange-500 font-bold whitespace-nowrap">
                {daily_rate} €
                <span class="text-sm font-normal text-slate-500">/ day</span>
            </p>
        </div>

        <dl class="grid grid-cols-2 gap-x-4 gap-y-2 text-sm mb-5">
            <dt class="text-slate-500">Transmission</dt>
            <dd class="text-right font-medium text-slate-700 capitalize">
                {transmission}
            </dd>

            <dt class="text-slate-500">Fuel</dt>
            <dd class="text-right font-medium text-slate-700 capitalize">
                {fuel}
            </dd>

            <dt class="text-slate-500">Seats</dt>
            <dd class="text-right font-medium text-slate-700">{seats}</dd>

            <dt class="text-slate-500">Doors</dt>
            <dd class="text-right font-medium text-slate-700">{doors}</dd>

            <dt class="text-slate-500">Air conditioning</dt>
            <dd class="text-right font-medium text-slate-700">
                {air_conditioning ? "Yes" : "No"}
            </dd>
        </dl>

        {
            !available ? (
                <button
                    type="button"
                    disabled
                    class="btn bg-slate-300 text-slate-500 border-none shadow-none mt-auto cursor-not-allowed"
                >
                    Not available
                </button>
            ) : hasDates ? (
                <a href={extrasUrl} class={selectClass}>
                    Select
                </a>
            ) : (
                // Availability can't be confirmed yet: CarDatesModal asks for the dates
                <button
                    type="button"
                    x-data="{}"
                    @click="$dispatch('dates-required')"
                    class={selectClass}
                >
                    Select
                </button>
            )
        }
    </div>
</article>
