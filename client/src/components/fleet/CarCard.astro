---
import type { Car } from "@/types/car";

interface Props {
    car: Car;
}

const { car } = Astro.props;

const name = `${car.make} ${car.model} ${car.model_year}`;

---

<article
    class:list={[
        "rounded-2xl border shadow-sm overflow-hidden flex flex-col",
        car.available
            ? "bg-white border-slate-100"
            : "bg-slate-100 border-slate-200 grayscale opacity-75",
    ]}
>
    <div class="relative">
        <img
            src={car.image_url}
            alt={name}
            loading="lazy"
            class="w-full h-48 object-cover"
        />
    </div>

    <div class="p-5 flex flex-col flex-1">
        <div class="flex items-start justify-between gap-3 mb-4">
            <h3 class="text-lg font-bold">{name}</h3>
            <p class="text-orange-500 font-bold whitespace-nowrap">
                {car.daily_rate} €
                <span class="text-sm font-normal text-slate-500">/ day</span>
            </p>
        </div>

        <dl class="grid grid-cols-2 gap-x-4 gap-y-2 text-sm mb-5">
            <dt class="text-slate-500">Transmission</dt>
            <dd class="text-right font-medium text-slate-700 capitalize">
                {car.transmission}
            </dd>

            <dt class="text-slate-500">Fuel</dt>
            <dd class="text-right font-medium text-slate-700 capitalize">
                {car.fuel}
            </dd>

            <dt class="text-slate-500">Seats</dt>
            <dd class="text-right font-medium text-slate-700">{car.seats}</dd>

            <dt class="text-slate-500">Doors</dt>
            <dd class="text-right font-medium text-slate-700">{car.doors}</dd>
        </dl>

        {
            car.available ? (
                <a
                    href={`/rent-a-car/${car.id}`}
                    class="btn bg-orange-500 hover:bg-orange-600 text-white border-none shadow-none mt-auto"
                >
                    Select
                </a>
            ) : (
                <button
                    type="button"
                    disabled
                    class="btn bg-slate-300 text-slate-500 border-none shadow-none mt-auto cursor-not-allowed"
                >
                    Not available
                </button>
            )
        }
    </div>
</article>
