---
import "flatpickr/dist/flatpickr.min.css";

interface Props {
    /** Prefix for the field ids, needed when the fields appear twice on a page */
    idPrefix?: string;
}

const { idPrefix = "" } = Astro.props;

const pickupDateId = `${idPrefix}pickup-date`;
const pickupTimeId = `${idPrefix}pickup-time`;
const returnDateId = `${idPrefix}return-date`;
const returnTimeId = `${idPrefix}return-time`;
---

<input type="hidden" name="pickup" :value="pickupAt" />
<input type="hidden" name="return" :value="returnAt" />

<div class="flex flex-col text-left">
    <label class="text-sm font-bold mb-1">Pickup date &amp; time</label>
    <div class="flex gap-2">
        <div class="flex flex-col flex-1">
            <label class="text-xs text-gray-500 mb-1" for={pickupDateId}>Date</label>
            <input
                id={pickupDateId}
                type="text"
                placeholder="Select date"
                x-ref="pickupDateInput"
                class="input input-bordered w-full"
            />
        </div>
        <div class="flex flex-col flex-1">
            <label class="text-xs text-gray-500 mb-1" for={pickupTimeId}>Hour</label>
            <input
                id={pickupTimeId}
                type="text"
                placeholder="Select hour"
                x-ref="pickupTimeInput"
                class="input input-bordered w-full"
            />
        </div>
    </div>
    <p x-show="pickupError" x-text="pickupError" x-cloak class="text-sm text-red-600 mt-1"></p>
</div>

<div class="flex flex-col text-left">
    <label class="text-sm font-bold mb-1">Return date &amp; time</label>
    <div class="flex gap-2">
        <div class="flex flex-col flex-1">
            <label class="text-xs text-gray-500 mb-1" for={returnDateId}>Date</label>
            <input
                id={returnDateId}
                type="text"
                placeholder="Select date"
                x-ref="returnDateInput"
                class="input input-bordered w-full"
            />
        </div>
        <div class="flex flex-col flex-1">
            <label class="text-xs text-gray-500 mb-1" for={returnTimeId}>Hour</label>
            <input
                id={returnTimeId}
                type="text"
                placeholder="Select hour"
                x-ref="returnTimeInput"
                class="input input-bordered w-full"
            />
        </div>
    </div>
    <p x-show="returnError" x-text="returnError" x-cloak class="text-sm text-red-600 mt-1"></p>
</div>

<script>
    import Alpine from "alpinejs";
    import flatpickr from "flatpickr";
    import type { Instance } from "flatpickr/dist/types/instance";
    import type { RentalSearchConfig } from "@/lib/rental-search";

    const isBlockedDate = (date: Date) =>
        (date.getMonth() === 11 && date.getDate() === 25) ||
        (date.getMonth() === 0 && date.getDate() === 1);

    const dateOptions = {
        enableTime: false,
        dateFormat: "Y-m-d",
        minDate: "today",
        disable: [isBlockedDate],
    };

    const timeOptions = {
        enableTime: true,
        noCalendar: true,
        time_24hr: true,
        dateFormat: "H:i",
        minuteIncrement: 5,
        minTime: "06:00",
        maxTime: "23:55",
        defaultHour: 10,
    };

    function combineDateTime(date: string, time: string): string {
        if (!date) return "";
        if (!time) return date;
        return `${date} ${time}`;
    }

    function splitDateTime(value: string): { date: string; time: string } {
        if (!value) return { date: "", time: "" };
        const parts = value.split(" ");
        return { date: parts[0] || "", time: parts[1] || "" };
    }

    document.addEventListener("alpine:init", () => {
        Alpine.data("rentalSearch", (config: RentalSearchConfig) => ({
            ...config,
            ageConfirmed: false,
            submitted: false,
            returnDatePicker: null as Instance | null,
            returnTimePicker: null as Instance | null,

            init() {
                const pickupInitial = splitDateTime(this.pickupAt);
                const returnInitial = splitDateTime(this.returnAt);

                this.returnTimePicker = flatpickr(this.$refs.returnTimeInput, {
                    ...timeOptions,
                    defaultDate: returnInitial.time || undefined,
                    onChange: (_dates, value) => {
                        this.returnAt = combineDateTime(
                            splitDateTime(this.returnAt).date,
                            value,
                        );
                        this.syncReturnPickerConstraints();
                    },
                });

                this.returnDatePicker = flatpickr(this.$refs.returnDateInput, {
                    ...dateOptions,
                    defaultDate: returnInitial.date || undefined,
                    onChange: (dates, value) => {
                        this.returnAt = combineDateTime(
                            value,
                            splitDateTime(this.returnAt).time,
                        );
                        this.syncReturnPickerConstraints();
                    },
                });

                flatpickr(this.$refs.pickupTimeInput, {
                    ...timeOptions,
                    defaultDate: pickupInitial.time || undefined,
                    onChange: (_dates, value) => {
                        this.pickupAt = combineDateTime(
                            splitDateTime(this.pickupAt).date,
                            value,
                        );
                        this.syncReturnPickerConstraints();
                    },
                });

                flatpickr(this.$refs.pickupDateInput, {
                    ...dateOptions,
                    defaultDate: pickupInitial.date || undefined,
                    onChange: (dates, value) => {
                        this.pickupAt = combineDateTime(
                            value,
                            splitDateTime(this.pickupAt).time,
                        );
                        this.returnDatePicker?.set("minDate", dates[0]);
                        this.syncReturnPickerConstraints();
                    },
                });

                if (this.pickupAt !== "") this.syncReturnPickerConstraints();
            },

            syncReturnPickerConstraints() {
                const pickup = splitDateTime(this.pickupAt);
                const ret = splitDateTime(this.returnAt);

                if (!pickup.date) return;

                const pickupDateObj = new Date(pickup.date);

                this.returnDatePicker?.set("minDate", pickupDateObj);

                if (pickup.date === ret.date && pickup.time) {
                    this.returnTimePicker?.set("minTime", pickup.time);
                } else {
                    this.returnTimePicker?.set("minTime", "06:00");
                }
            },

            get pickupError() {
                if (!this.submitted || !this.requireDates || this.pickupAt !== "")
                    return "";
                return "Please select a pickup date & time.";
            },

            get returnError() {
                if (!this.submitted || !this.requireDates || this.returnAt !== "")
                    return "";
                return "Please select a return date & time.";
            },

            get ageError() {
                if (!this.submitted || !this.requireAge || this.ageConfirmed)
                    return "";
                return "You must confirm the driver is 25+ years.";
            },

            get isValid() {
                return (
                    this.pickupError === "" &&
                    this.returnError === "" &&
                    this.ageError === ""
                );
            },

            onSubmit(event: SubmitEvent) {
                this.submitted = true;
                if (!this.isValid) event.preventDefault();
            },
        }));
    });
</script>
