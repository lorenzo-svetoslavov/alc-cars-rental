---
import "flatpickr/dist/flatpickr.min.css";

interface Props {
    /** Prefix for the field ids, needed when the fields appear twice on a page */
    idPrefix?: string;
}

const { idPrefix = "" } = Astro.props;

const pickupId = `${idPrefix}pickup-date`;
const returnId = `${idPrefix}return-date`;
---

<div class="flex flex-col text-left">
    <label class="text-sm font-bold mb-1" for={pickupId}>Pickup date &amp; time</label>
    <input
        id={pickupId}
        name="pickup"
        type="text"
        placeholder="Select date & time"
        x-ref="pickupInput"
        x-model="pickupAt"
        class="input input-bordered w-full"
    />
    <p x-show="pickupError" x-text="pickupError" x-cloak class="text-sm text-red-600 mt-1"></p>
</div>

<div class="flex flex-col text-left">
    <label class="text-sm font-bold mb-1" for={returnId}>Return date &amp; time</label>
    <input
        id={returnId}
        name="return"
        type="text"
        placeholder="Select date & time"
        x-ref="returnInput"
        x-model="returnAt"
        class="input input-bordered w-full"
    />
    <p x-show="returnError" x-text="returnError" x-cloak class="text-sm text-red-600 mt-1"></p>
</div>

<script>
    import Alpine from "alpinejs";
    import flatpickr from "flatpickr";
    import type { Instance } from "flatpickr/dist/types/instance";
    import type { RentalSearchConfig } from "@/lib/rental-search";

    // Blocked holidays (month is 0-11, any year)
    const isBlockedDate = (date: Date) =>
        (date.getMonth() === 11 && date.getDate() === 25) ||
        (date.getMonth() === 0 && date.getDate() === 1);

    const dateTimeOptions = {
        enableTime: true,
        time_24hr: true,
        dateFormat: "Y-m-d H:i",
        minuteIncrement: 5,
        minTime: "06:00",
        maxTime: "23:55",
        defaultHour: 10,
        minDate: "today",
        disable: [isBlockedDate],
    };

    document.addEventListener("alpine:init", () => {
        // Always instantiated through rentalSearchData(), so the config
        // arrives with every default already resolved
        Alpine.data("rentalSearch", (config: RentalSearchConfig) => ({
            ...config,
            ageConfirmed: false,
            submitted: false,
            returnPicker: null as Instance | null,

            init() {
                this.returnPicker = flatpickr(this.$refs.returnInput, {
                    ...dateTimeOptions,
                    defaultDate: this.returnAt || undefined,
                    onChange: (_dates, value) => {
                        this.returnAt = value;
                        this.syncMinReturnTime();
                    },
                });

                flatpickr(this.$refs.pickupInput, {
                    ...dateTimeOptions,
                    defaultDate: this.pickupAt || undefined,
                    onChange: (dates, value) => {
                        this.pickupAt = value;
                        // Return date can't be before the pickup date
                        this.returnPicker?.set("minDate", dates[0]);
                        this.syncMinReturnTime();
                    },
                });

                // Values restored from the query string
                if (this.pickupAt !== "") this.syncMinReturnTime();
            },

            // If pickup and return happen on the same day, the return
            // time can't be earlier than the pickup time
            syncMinReturnTime() {
                const pickupDate = this.pickupAt.split(" ")[0];
                const returnDate = this.returnAt.split(" ")[0];

                if (pickupDate === "") return;

                this.returnPicker?.set(
                    "minDate",
                    pickupDate === returnDate ? this.pickupAt : pickupDate,
                );
            },

            get pickupError() {
                if (!this.submitted || !this.requireDates || this.pickupAt !== "")
                    return "";
                return "Please select a pickup date & time.";
            },

            get returnError() {
                if (!this.submitted || !this.requireDates || this.returnAt !== "")
                    return "";
                return "Please select a return date & time.";
            },

            get ageError() {
                if (!this.submitted || !this.requireAge || this.ageConfirmed)
                    return "";
                return "You must confirm the driver is 25+ years.";
            },

            get isValid() {
                return (
                    this.pickupError === "" &&
                    this.returnError === "" &&
                    this.ageError === ""
                );
            },

            onSubmit(event: SubmitEvent) {
                this.submitted = true;
                if (!this.isValid) event.preventDefault();
            },
        }));
    });
</script>
