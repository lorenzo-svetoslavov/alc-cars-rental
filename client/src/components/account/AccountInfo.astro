---
---

<div
	class="bg-white rounded-lg border border-gray-200 p-6"
	x-data="accountInfo()"
	x-init="init()"
>
	<div class="flex items-center gap-3 sm:gap-4 mb-6">
		<div
			class="w-11 h-11 sm:w-14 sm:h-14 rounded-full bg-orange-100 flex items-center justify-center text-orange-700 font-semibold text-base sm:text-lg shrink-0"
			x-text="getInitials()"
		>
		</div>
		<div class="flex-1 min-w-0">
			<h1 class="text-base sm:text-lg font-semibold text-gray-900 truncate" x-text="getFullName()"></h1>
			<p class="text-xs sm:text-sm text-gray-500 truncate" x-text="user?.email"></p>
		</div>
		<button
			type="button"
			class="btn btn-sm bg-orange-500 hover:bg-orange-600 text-white border-none shrink-0"
			@click="editing = true"
			x-show="!editing"
		>
			<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
			</svg>
			<span class="hidden sm:inline ml-1">Edit Profile</span>
		</button>
	</div>

	<!-- View Mode -->
	<div x-show="!editing" class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-4">
		<div>
			<p class="text-xs font-medium text-gray-400 uppercase tracking-wide mb-1">Phone</p>
			<p class="text-sm text-gray-700" x-text="customer?.phone || '—'"></p>
		</div>
		<div>
			<p class="text-xs font-medium text-gray-400 uppercase tracking-wide mb-1">DNI / NIE</p>
			<p class="text-sm text-gray-700" x-text="customer?.id_number || '—'"></p>
		</div>
		<div>
			<p class="text-xs font-medium text-gray-400 uppercase tracking-wide mb-1">Driver's License</p>
			<p class="text-sm text-gray-700" x-text="customer?.drivers_license || '—'"></p>
		</div>
		<div>
			<p class="text-xs font-medium text-gray-400 uppercase tracking-wide mb-1">Address</p>
			<p class="text-sm text-gray-700" x-text="customer?.address || '—'"></p>
		</div>
	</div>

	<!-- Edit Mode -->
	<div x-show="editing" x-cloak class="mt-2">
		<div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-4">
			<div>
				<label class="block text-xs font-medium text-gray-400 uppercase tracking-wide mb-1">First Name</label>
				<input type="text" x-model="form.first_name" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-900 focus:border-orange-500 focus:ring-1 focus:ring-orange-500 outline-none" />
			</div>
			<div>
				<label class="block text-xs font-medium text-gray-400 uppercase tracking-wide mb-1">Last Name</label>
				<input type="text" x-model="form.last_name" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-900 focus:border-orange-500 focus:ring-1 focus:ring-orange-500 outline-none" />
			</div>
			<div>
				<label class="block text-xs font-medium text-gray-400 uppercase tracking-wide mb-1">Phone</label>
				<input type="text" x-model="form.phone" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-900 focus:border-orange-500 focus:ring-1 focus:ring-orange-500 outline-none" />
			</div>
			<div>
				<label class="block text-xs font-medium text-gray-400 uppercase tracking-wide mb-1">DNI / NIE</label>
				<input type="text" x-model="form.id_number" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-900 focus:border-orange-500 focus:ring-1 focus:ring-orange-500 outline-none" />
			</div>
			<div>
				<label class="block text-xs font-medium text-gray-400 uppercase tracking-wide mb-1">Driver's License</label>
				<input type="text" x-model="form.drivers_license" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-900 focus:border-orange-500 focus:ring-1 focus:ring-orange-500 outline-none" />
			</div>
			<div>
				<label class="block text-xs font-medium text-gray-400 uppercase tracking-wide mb-1">Address</label>
				<input type="text" x-model="form.address" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-900 focus:border-orange-500 focus:ring-1 focus:ring-orange-500 outline-none" />
			</div>
		</div>
		<p x-show="error" x-text="error" class="text-red-500 text-sm mt-3"></p>
		<div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 mt-5">
			<button
				type="button"
				class="btn btn-sm bg-orange-500 hover:bg-orange-600 text-white border-none"
				:disabled="saving"
				@click="save()"
			>
				<template x-if="!saving"><span>Save Changes</span></template>
				<template x-if="saving"><span>Saving...</span></template>
			</button>
			<button
				type="button"
				class="btn btn-sm bg-gray-100 hover:bg-gray-200 text-gray-700 border-none"
				@click="editing = false; error = ''"
			>
				Cancel
			</button>
		</div>
	</div>
</div>

<script>
	import Alpine from "alpinejs";
	import { supabase } from "@/lib/supabase";

	Alpine.data("accountInfo", () => ({
		user: null,
		customer: null,
		editing: false,
		saving: false,
		error: "",
		form: {
			first_name: "",
			last_name: "",
			phone: "",
			id_number: "",
			drivers_license: "",
			address: "",
		},

		async init() {
			const { data: { session } } = await supabase.auth.getSession();
			if (!session) return;

			this.user = session.user;
			await this.fetchCustomer();

			supabase.auth.onAuthStateChange(async (_event, session) => {
				this.user = session?.user || null;
				if (this.user) await this.fetchCustomer();
			});
		},

		async fetchCustomer() {
			if (!this.user) return;

			const { data, error } = await supabase
				.from("customers")
				.select("*")
				.eq("id", this.user.id)
				.single();

			if (error) {
				console.error("Error fetching customer:", error);
				return;
			}

			this.customer = data;
			this.populateForm();
		},

		populateForm() {
			if (!this.customer) return;
			this.form.first_name = this.customer.first_name || "";
			this.form.last_name = this.customer.last_name || "";
			this.form.phone = this.customer.phone || "";
			this.form.id_number = this.customer.id_number || "";
			this.form.drivers_license = this.customer.drivers_license || "";
			this.form.address = this.customer.address || "";
		},

		getInitials() {
			const first = this.customer?.first_name?.[0] || "";
			const last = this.customer?.last_name?.[0] || "";
			return (first + last).toUpperCase() || this.user?.email?.[0]?.toUpperCase() || "U";
		},

		getFullName() {
			const first = this.customer?.first_name || "";
			const last = this.customer?.last_name || "";
			return (first + " " + last).trim() || this.user?.email || "User";
		},

		async save() {
			this.saving = true;
			this.error = "";

			const { error: dbError } = await supabase
				.from("customers")
				.update({
					first_name: this.form.first_name,
					last_name: this.form.last_name,
					phone: this.form.phone,
					id_number: this.form.id_number,
					drivers_license: this.form.drivers_license,
					address: this.form.address,
					updated_at: new Date().toISOString(),
				})
				.eq("id", this.user.id);

			if (dbError) {
				this.error = dbError.message || "Failed to update profile.";
				this.saving = false;
				return;
			}

			const { error: authError } = await supabase.auth.updateUser({
				data: {
					first_name: this.form.first_name,
					last_name: this.form.last_name,
					phone: this.form.phone,
					dni: this.form.id_number,
					drivers_license: this.form.drivers_license,
					address: this.form.address,
				},
			});

			if (authError) {
				console.error("Auth metadata sync failed:", authError);
			}

			await this.fetchCustomer();
			this.saving = false;
			this.editing = false;
		},
	}));
</script>
