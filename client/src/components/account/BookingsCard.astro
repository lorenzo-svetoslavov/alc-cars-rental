---

---

<div
	class="bg-white rounded-lg border border-gray-200 p-6"
	x-data="bookingsCard()"
	x-init="init()"
>
	<h2 class="text-lg font-bold text-orange-500 mb-4">Your Bookings</h2>

	<!-- Loading -->
	<div x-show="loading" class="flex items-center justify-center py-6">
		<svg class="animate-spin h-5 w-5 text-orange-500" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="4" class="opacity-25"/><path fill="currentColor" d="M4 12a8 8 0 0 1 8-8V0C5.373 0 0 5.373 0 12z" class="opacity-75"/></svg>
	</div>

	<!-- Empty -->
	<div
		x-show="!loading && bookings.length === 0"
		class="text-center py-6 text-gray-400"
	>
		<svg fill="none" stroke="currentColor" class="w-10 h-10 mx-auto mb-2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2"/></svg>
		<p class="text-sm">No bookings yet</p>
	</div>

	<!-- Bookings list -->
	<div x-show="!loading && bookings.length > 0" class="flex flex-col">
		<template x-for="(b, i) in bookings" :key="b.id">
			<div
				class="py-4 transition-colors"
				:class="{ 'border-t border-gray-100': i > 0 }"
			>
				<div class="flex items-start justify-between gap-4">
					<div class="flex-1 min-w-0">
						<h3
							class="text-sm font-semibold text-gray-900 tracking-tight mb-2"
							x-text="b.cars ? b.cars.make + ' ' + b.cars.model + ' ' + b.cars.color + ' ' + b.cars.model_year : 'Vehicle'"
						>
						</h3>
						<div class="flex flex-col gap-2">
							<div
								class="flex items-center gap-2.5 text-xs"
							>
								<span class="flex items-center justify-center w-5 h-5 rounded-full bg-green-50 text-green-600 shrink-0">
									<svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7"/></svg>
								</span>
								<span class="text-gray-400 w-14 shrink-0 uppercase text-[10px] tracking-wider font-medium">Pick-up</span>
								<span class="text-gray-700 font-medium" x-text="formatDateTime(b.pickup_at)"></span>
							</div>
							<div
								class="flex items-center gap-2.5 text-xs"
							>
								<span class="flex items-center justify-center w-5 h-5 rounded-full bg-red-50 text-red-500 shrink-0">
									<svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
								</span>
								<span class="text-gray-400 w-14 shrink-0 uppercase text-[10px] tracking-wider font-medium">Drop-off</span>
								<span class="text-gray-700 font-medium" x-text="formatDateTime(b.dropoff_at)"></span>
							</div>
						</div>
					</div>
					<div class="text-right shrink-0">
						<p
							class="text-sm font-semibold text-gray-900"
							x-text="'€' + Number(b.price).toFixed(2)"
						>
						</p>
					</div>
				</div>
			</div>
		</template>
	</div>
</div>

<script>
	import Alpine from "alpinejs";
	import { supabase } from "@/lib/supabase";

	Alpine.data("bookingsCard", () => ({
		bookings: [],
		loading: true,

		async init() {
			const {
				data: { session },
			} = await supabase.auth.getSession();
			if (!session) {
				this.loading = false;
				return;
			}

			await this.fetchBookings();

			supabase.auth.onAuthStateChange(async (_event, session) => {
				if (session) {
					await this.fetchBookings();
				} else {
					this.bookings = [];
				}
			});
		},

		async fetchBookings() {
			this.loading = true;

			const { data, error } = await supabase
				.from("bookings")
				.select("*, cars(make, model, model_year, color)")
				.order("pickup_at", { ascending: false });

			if (error) {
				console.error("Error fetching bookings:", error);
				this.loading = false;
				return;
			}

			this.bookings = data || [];
			this.loading = false;
		},

		formatDateTime(iso) {
			if (!iso) return "—";
			const d = new Date(iso);
			const date = d.toLocaleDateString("en-GB", {
				day: "numeric",
				month: "short",
				year: "numeric",
			});
			const time = d.toLocaleTimeString("en-GB", {
				hour: "2-digit",
				minute: "2-digit",
			});
			return `${date} · ${time}`;
		},
	}));
</script>
