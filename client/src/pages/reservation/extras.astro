---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/layouts/Header.astro";
import Footer from "@/layouts/Footer.astro";
import ReservationSteps from "@/components/shared/ReservationSteps.astro";
import ReservationSummary from "@/components/shared/ReservationSummary.astro";
import { supabase } from "@/lib/supabase";
import type { Car } from "@/types/car";
import type { Extra } from "@/types/extra";

const carId = Astro.url.searchParams.get("car");
const pickup = Astro.url.searchParams.get("pickup");
const returnDate = Astro.url.searchParams.get("return");
const extrasParam = Astro.url.searchParams.get("extras");

let car: Car | null = null;
let extras: Extra[] = [];
let selectedExtras: { id: string; name: string; price: number; pricing: string }[] = [];

if (carId) {
    const { data } = await supabase
        .from("cars")
        .select("*")
        .eq("id", carId)
        .single();

    car = data;
}

const { data: extrasData } = await supabase
    .from("extras")
    .select("*")
    .eq("active", true)
    .order("price");

extras = extrasData ?? [];

if (extrasParam) {
    const ids = extrasParam.split(",");
    selectedExtras = extras.filter((e) => ids.includes(e.id));
}

const baseParams = `car=${carId}&pickup=${encodeURIComponent(pickup ?? "")}&return=${encodeURIComponent(returnDate ?? "")}`;
---

<BaseLayout title="Extras · ALC Cars">
    <Header />

    <main class="max-w-6xl mx-auto px-4 py-16 flex-1 w-full">
        <ReservationSteps currentStep={2} params={baseParams} />

        <header class="mb-10">
            <h1 class="text-2xl md:text-3xl font-bold text-slate-800">
                Extras
            </h1>
            <p class="text-slate-400 mt-1 text-sm">
                Add optional services to your reservation
            </p>
        </header>

        <div class="flex flex-col md:flex-row gap-8 items-start">
            <div class="flex-1 min-w-0">
                {car && (
                    <div class="mb-10">
                        <h2 class="text-xs font-semibold text-slate-400 uppercase tracking-widest mb-3">Your car</h2>
                        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-4 p-4 rounded-2xl bg-white border border-slate-100">
                            <div class="flex items-center gap-3 sm:gap-4 flex-1 min-w-0">
                                <img
                                    src={car.image_url}
                                    alt={`${car.make} ${car.model} ${car.color}`}
                                    class="w-16 h-12 sm:w-20 sm:h-14 object-cover rounded-xl shrink-0"
                                />
                                <p class="font-semibold text-sm text-slate-800 truncate">{car.make} {car.model} {car.model_year} {car.color}</p>
                            </div>
                            <div class="flex flex-col gap-1.5 sm:items-end">
                                <div class="flex items-center gap-2">
                                    <span class="flex items-center justify-center w-5 h-5 rounded-full bg-green-50 text-green-600 shrink-0">
                                        <svg fill="none" stroke="currentColor" stroke-width="2.5" class="w-3 h-3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m5 15 7-7 7 7"/></svg>
                                    </span>
                                    <span class="text-xs font-medium text-slate-700">{pickup}</span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <span class="flex items-center justify-center w-5 h-5 rounded-full bg-red-50 text-red-500 shrink-0">
                                        <svg fill="none" stroke="currentColor" stroke-width="2.5" class="w-3 h-3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m19 9-7 7-7-7"/></svg>
                                    </span>
                                    <span class="text-xs font-medium text-slate-700">{returnDate}</span>
                                </div>
                                <span class="text-sm font-bold text-orange-500">{car.daily_rate} €<span class="font-normal text-slate-400">/day</span></span>
                            </div>
                        </div>
                    </div>
                )}

                <div>
                    <h2 class="text-xs font-semibold text-slate-400 uppercase tracking-widest mb-3">Extras</h2>
                    {extras.length > 0 ? (
                    <div class="space-y-2" id="extras-list">
                        {extras.map((extra) => (
                            <label class="extra-card flex items-center gap-4 p-4 rounded-2xl border border-slate-100 bg-white cursor-pointer transition-all hover:border-orange-200 hover:shadow-sm has-[:checked]:border-orange-400 has-[:checked]:bg-orange-50/50">
                                <input
                                    type="checkbox"
                                    name="extras"
                                    value={extra.id}
                                    data-name={extra.name}
                                    data-price={extra.price}
                                    data-pricing={extra.pricing}
                                    class="checkbox checkbox-sm checkbox-primary border-slate-300 checked:border-orange-500 checked:bg-orange-500"
                                />
                                <div class="flex-1 min-w-0">
                                    <span class="font-medium text-sm text-slate-800">{extra.name}</span>
                                    <p class="text-xs text-slate-400 mt-0.5">{extra.description}</p>
                                </div>
                                <span class="text-sm font-semibold text-orange-500 shrink-0">
                                    +{extra.price.toFixed(2)} €<span class="font-normal text-slate-400 text-xs"> / {extra.pricing === "per_day" ? "day" : "trip"}</span>
                                </span>
                            </label>
                        ))}
                    </div>
                ) : (
                    <p class="text-slate-400 text-center py-12 text-sm">
                        No extras available at the moment.
                    </p>
                )}
                </div>

                <div class="flex justify-between mt-10">
                    <a
                        href={`/rent-a-car?${baseParams}`}
                        class="btn bg-white border-slate-200 text-slate-600 hover:bg-slate-50 shadow-none"
                    >
                        ← Back
                    </a>
                    <a
                        id="continue-btn"
                        href={`/reservation/datos?${baseParams}`}
                        class="btn bg-orange-500 hover:bg-orange-600 text-white border-none shadow-none"
                    >
                        Continue →
                    </a>
                </div>
            </div>

            <ReservationSummary car={car} pickup={pickup} returnDate={returnDate} extras={selectedExtras} />
        </div>

        <script>
            function updateSummary() {
                const checked = document.querySelectorAll<HTMLInputElement>('input[name="extras"]:checked');
                const ids = Array.from(checked).map((el) => el.value);
                const btn = document.getElementById("continue-btn") as HTMLAnchorElement;

                if (btn) {
                    const url = new URL(btn.href);
                    if (ids.length > 0) {
                        url.searchParams.set("extras", ids.join(","));
                    } else {
                        url.searchParams.delete("extras");
                    }
                    btn.href = url.toString();
                }

                const carTotal = window.__summaryCarTotal ?? 0;
                const days = window.__summaryDays ?? 1;
                const extrasContainer = document.getElementById("summary-extras");
                const totalEl = document.getElementById("summary-total");

                if (!extrasContainer || !totalEl) return;

                extrasContainer.innerHTML = "";
                let extrasTotal = 0;

                checked.forEach((input) => {
                    const name = input.dataset.name ?? "";
                    const price = parseFloat(input.dataset.price ?? "0");
                    const pricing = input.dataset.pricing ?? "per_booking";
                    const lineTotal = pricing === "per_day" ? price * days : price;
                    extrasTotal += lineTotal;

                    const div = document.createElement("div");
                    div.className = "flex justify-between";
                    div.innerHTML = `<span class="text-slate-600">${name}</span><span class="font-medium text-slate-700">${lineTotal.toFixed(2)} €</span>`;
                    extrasContainer.appendChild(div);
                });

                totalEl.textContent = `${(carTotal + extrasTotal).toFixed(2)} €`;
            }

            function initExtras() {
                const params = new URLSearchParams(window.location.search);
                const savedExtras = params.get("extras");

                if (savedExtras) {
                    const ids = savedExtras.split(",");
                    ids.forEach((id) => {
                        const checkbox = document.querySelector<HTMLInputElement>(
                            `input[name="extras"][value="${id}"]`
                        );
                        if (checkbox) checkbox.checked = true;
                    });
                }

                const btn = document.getElementById("continue-btn") as HTMLAnchorElement;
                if (btn && savedExtras) {
                    const url = new URL(btn.href);
                    url.searchParams.set("extras", savedExtras);
                    btn.href = url.toString();
                }

                updateSummary();
            }

            document.querySelectorAll('input[name="extras"]').forEach((input) => {
                input.addEventListener("change", updateSummary);
            });

            initExtras();
        </script>
    </main>

    <Footer />
</BaseLayout>
