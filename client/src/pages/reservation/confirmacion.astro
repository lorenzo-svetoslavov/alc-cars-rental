---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/layouts/Header.astro";
import Footer from "@/layouts/Footer.astro";
import ReservationSteps from "@/components/shared/ReservationSteps.astro";
import { supabase } from "@/lib/supabase";
import type { Car } from "@/types/car";

const carId = Astro.url.searchParams.get("car");
const pickup = Astro.url.searchParams.get("pickup");
const returnDate = Astro.url.searchParams.get("return");
const extrasParam = Astro.url.searchParams.get("extras");

let car: Car | null = null;
let selectedExtras: { id: string; name: string; price: number; pricing: string }[] = [];

if (carId) {
    const { data } = await supabase
        .from("cars")
        .select("*")
        .eq("id", carId)
        .single();
    car = data;
}

if (extrasParam) {
    const ids = extrasParam.split(",");
    const { data } = await supabase
        .from("extras")
        .select("id, name, price, pricing")
        .in("id", ids);
    selectedExtras = data ?? [];
}

const baseParams = `car=${carId}&pickup=${encodeURIComponent(pickup ?? "")}&return=${encodeURIComponent(returnDate ?? "")}${extrasParam ? `&extras=${extrasParam}` : ""}`;

const pickupMs = pickup ? new Date(pickup).getTime() : 0;
const returnMs = returnDate ? new Date(returnDate).getTime() : 0;
const days = Math.max(1, Math.ceil((returnMs - pickupMs) / (1000 * 60 * 60 * 24)));
const carTotal = car ? car.daily_rate * days : 0;

let extrasTotal = 0;
selectedExtras.forEach((extra) => {
    extrasTotal += extra.pricing === "per_day" ? extra.price * days : extra.price;
});

const total = carTotal + extrasTotal;
---

<BaseLayout title="Confirm Reservation · ALC Cars">
    <Header />

    <main class="max-w-6xl mx-auto px-4 py-16 flex-1 w-full">
        <ReservationSteps currentStep={4} params={baseParams} />

        <div x-data="confirmation()" x-init="init()">
            <!-- Loading state -->
            <div x-show="loading" class="flex flex-col items-center justify-center py-20">
                <svg class="animate-spin h-8 w-8 text-orange-500 mb-4" viewBox="0 0 24 24">
                    <circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="4" class="opacity-25"/>
                    <path fill="currentColor" d="M4 12a8 8 0 0 1 8-8V0C5.373 0 0 5.373 0 12z" class="opacity-75"/>
                </svg>
                <p class="text-slate-400 text-sm">Processing your reservation...</p>
            </div>

            <!-- Error state -->
            <div x-show="error" x-cloak class="max-w-lg mx-auto text-center py-20">
                <div class="w-16 h-16 rounded-full bg-red-50 flex items-center justify-center mx-auto mb-4">
                    <svg class="w-8 h-8 text-red-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </div>
                <h2 class="text-xl font-bold text-slate-800 mb-2">Something went wrong</h2>
                <p class="text-slate-400 text-sm mb-6" x-text="error"></p>
                <a href="/" class="btn bg-orange-500 hover:bg-orange-600 text-white border-none shadow-none">
                    Go home
                </a>
            </div>

            <!-- Review state: show summary + confirm button -->
            <div x-show="!loading && !error && !booking && form" x-cloak>
                <header class="text-center mb-10">
                    <h1 class="text-2xl md:text-3xl font-bold text-slate-800">
                        Review your reservation
                    </h1>
                    <p class="text-slate-400 mt-1 text-sm">
                        Please confirm all details are correct before booking
                    </p>
                </header>

                <div class="flex flex-col md:flex-row gap-6 md:gap-8 items-stretch md:items-start">
                    <div class="flex-1 min-w-0 w-full space-y-6">

                        <!-- Vehicle details -->
                        <div class="bg-white rounded-2xl border border-slate-100 p-6">
                            <h2 class="text-xs font-semibold text-slate-400 uppercase tracking-widest mb-4">Vehicle</h2>
                            <div class="flex items-center gap-4">
                                {car?.image_url && (
                                    <img src={car.image_url} alt={`${car.make} ${car.model}`} class="w-20 h-20 rounded-xl object-cover" />
                                )}
                                <div>
                                    <p class="font-semibold text-slate-800">{car?.make} {car?.model} {car?.model_year}</p>
                                    <p class="text-sm text-slate-500">{car?.color} · {car?.transmission === "automatic" ? "Automatic" : "Manual"} · {car?.fuel}</p>
                                    <p class="text-sm text-slate-400 mt-1">{car?.daily_rate} €/day</p>
                                </div>
                            </div>
                        </div>

                        <!-- Dates -->
                        <div class="bg-white rounded-2xl border border-slate-100 p-6">
                            <h2 class="text-xs font-semibold text-slate-400 uppercase tracking-widest mb-4">Dates</h2>
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                <div>
                                    <p class="text-xs text-slate-400">Pick-up</p>
                                    <p class="text-sm font-medium text-slate-800">{pickup}</p>
                                </div>
                                <div>
                                    <p class="text-xs text-slate-400">Drop-off</p>
                                    <p class="text-sm font-medium text-slate-800">{returnDate}</p>
                                </div>
                            </div>
                            <p class="text-sm text-slate-500 mt-3">Duration: {days} day{days !== 1 ? "s" : ""}</p>
                        </div>

                        <!-- Extras -->
                        {selectedExtras.length > 0 && (
                            <div class="bg-white rounded-2xl border border-slate-100 p-6">
                                <h2 class="text-xs font-semibold text-slate-400 uppercase tracking-widest mb-4">Extras</h2>
                                <div class="space-y-2">
                                    {selectedExtras.map((extra) => (
                                        <div class="flex justify-between">
                                            <span class="text-sm text-slate-600">{extra.name}</span>
                                            <span class="text-sm font-medium text-slate-700">{(extra.pricing === "per_day" ? extra.price * days : extra.price).toFixed(2)} €</span>
                                        </div>
                                    ))}
                                </div>
                            </div>
                        )}

                        <!-- Personal info -->
                        <div class="bg-white rounded-2xl border border-slate-100 p-6">
                            <h2 class="text-xs font-semibold text-slate-400 uppercase tracking-widest mb-4">Your information</h2>
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                <div>
                                    <p class="text-xs text-slate-400">Name</p>
                                    <p class="text-sm font-medium text-slate-800" x-text="form?.guest_name"></p>
                                </div>
                                <div>
                                    <p class="text-xs text-slate-400">Email</p>
                                    <p class="text-sm font-medium text-slate-800" x-text="form?.guest_email"></p>
                                </div>
                                <div>
                                    <p class="text-xs text-slate-400">Phone</p>
                                    <p class="text-sm font-medium text-slate-800" x-text="form?.guest_phone"></p>
                                </div>
                                <div>
                                    <p class="text-xs text-slate-400">DNI / NIE</p>
                                    <p class="text-sm font-medium text-slate-800" x-text="form?.guest_id_number"></p>
                                </div>
                                <div>
                                    <p class="text-xs text-slate-400">Driver's License</p>
                                    <p class="text-sm font-medium text-slate-800" x-text="form?.guest_drivers_license"></p>
                                </div>
                                <div>
                                    <p class="text-xs text-slate-400">Address</p>
                                    <p class="text-sm font-medium text-slate-800" x-text="form?.guest_address"></p>
                                </div>
                            </div>
                        </div>

                        <!-- Price summary -->
                        <div class="bg-white rounded-2xl border border-slate-100 p-6">
                            <h2 class="text-xs font-semibold text-slate-400 uppercase tracking-widest mb-4">Price summary</h2>
                            <div class="space-y-2">
                                <div class="flex justify-between">
                                    <span class="text-sm text-slate-600">Vehicle ({days} day{days !== 1 ? "s" : ""})</span>
                                    <span class="text-sm font-medium text-slate-700">{carTotal.toFixed(2)} €</span>
                                </div>
                                {selectedExtras.map((extra) => (
                                    <div class="flex justify-between">
                                        <span class="text-sm text-slate-600">{extra.name}</span>
                                        <span class="text-sm font-medium text-slate-700">{(extra.pricing === "per_day" ? extra.price * days : extra.price).toFixed(2)} €</span>
                                    </div>
                                ))}
                            </div>
                            <hr class="border-slate-100 my-4" />
                            <div class="flex justify-between items-center">
                                <span class="font-bold text-sm text-slate-800">Total</span>
                                <span class="font-bold text-orange-500 text-lg">{total.toFixed(2)} €</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Back link -->
                <div class="flex justify-between items-center mt-10">
                    <a
                        href={`/reservation/datos?${baseParams}`}
                        class="btn bg-white border-slate-200 text-slate-600 hover:bg-slate-50 shadow-none"
                    >
                        ← Back
                    </a>
                    <button
                        type="button"
                        class="btn bg-orange-500 hover:bg-orange-600 text-white border-none shadow-none"
                        :disabled="submitting"
                        @click="confirmBooking()"
                    >
                        <template x-if="!submitting"><span>Confirm Reservation</span></template>
                        <template x-if="submitting"><span>Processing...</span></template>
                    </button>
                </div>
            </div>

            <!-- Success state -->
            <div x-show="!loading && !error && booking" x-cloak>
                <header class="text-center mb-10">
                    <div class="w-16 h-16 rounded-full bg-green-50 flex items-center justify-center mx-auto mb-4">
                        <svg class="w-8 h-8 text-green-500" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                        </svg>
                    </div>
                    <h1 class="text-2xl md:text-3xl font-bold text-slate-800">
                        Reservation confirmed!
                    </h1>
                    <p class="text-slate-400 mt-1 text-sm">
                        Your booking has been successfully created
                    </p>
                </header>

                <div class="flex flex-col md:flex-row gap-6 md:gap-8 items-stretch md:items-start">
                    <div class="flex-1 min-w-0 w-full space-y-6">

                        <!-- Booking details -->
                        <div class="bg-white rounded-2xl border border-slate-100 p-6">
                            <h2 class="text-xs font-semibold text-slate-400 uppercase tracking-widest mb-4">Booking details</h2>

                            <div class="space-y-3">
                                <div class="flex justify-between">
                                    <span class="text-sm text-slate-500">Vehicle</span>
                                    <span class="text-sm font-medium text-slate-800">{car?.make} {car?.model} {car?.model_year} {car?.color}</span>
                                </div>
                                <div class="flex justify-between">
                                    <span class="text-sm text-slate-500">Pick-up</span>
                                    <span class="text-sm font-medium text-slate-800">{pickup}</span>
                                </div>
                                <div class="flex justify-between">
                                    <span class="text-sm text-slate-500">Drop-off</span>
                                    <span class="text-sm font-medium text-slate-800">{returnDate}</span>
                                </div>
                                <div class="flex justify-between">
                                    <span class="text-sm text-slate-500">Duration</span>
                                    <span class="text-sm font-medium text-slate-800">{days} day{days !== 1 ? "s" : ""}</span>
                                </div>
                                {selectedExtras.length > 0 && (
                                    <>
                                        <hr class="border-slate-100 my-2" />
                                        {selectedExtras.map((extra) => (
                                            <div class="flex justify-between">
                                                <span class="text-sm text-slate-500">{extra.name}</span>
                                                <span class="text-sm font-medium text-slate-700">{(extra.pricing === "per_day" ? extra.price * days : extra.price).toFixed(2)} €</span>
                                            </div>
                                        ))}
                                    </>
                                )}
                                <hr class="border-slate-100 my-2" />
                                <div class="flex justify-between items-center">
                                    <span class="font-bold text-sm text-slate-800">Total</span>
                                    <span class="font-bold text-orange-500 text-lg">{total.toFixed(2)} €</span>
                                </div>
                            </div>
                        </div>

                        <!-- Guest info -->
                        <div class="bg-white rounded-2xl border border-slate-100 p-6">
                            <h2 class="text-xs font-semibold text-slate-400 uppercase tracking-widest mb-4">Your information</h2>
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                <div>
                                    <p class="text-xs text-slate-400">Name</p>
                                    <p class="text-sm font-medium text-slate-800" x-text="booking?.guest_name"></p>
                                </div>
                                <div>
                                    <p class="text-xs text-slate-400">Email</p>
                                    <p class="text-sm font-medium text-slate-800" x-text="booking?.guest_email"></p>
                                </div>
                                <div>
                                    <p class="text-xs text-slate-400">Phone</p>
                                    <p class="text-sm font-medium text-slate-800" x-text="booking?.guest_phone"></p>
                                </div>
                                <div>
                                    <p class="text-xs text-slate-400">DNI / NIE</p>
                                    <p class="text-sm font-medium text-slate-800" x-text="booking?.guest_id_number"></p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="flex justify-center mt-10">
                    <a href="/" class="btn bg-slate-800 hover:bg-slate-900 text-white border-none shadow-none">
                        Back to home
                    </a>
                </div>
            </div>
        </div>
    </main>

    <Footer />
</BaseLayout>

<script>
    import Alpine from "alpinejs";
    import { supabase } from "@/lib/supabase";

    Alpine.data("confirmation", () => ({
        loading: true,
        error: "",
        booking: null,
        form: null,
        submitting: false,

        async init() {
            try {
                const params = new URLSearchParams(window.location.search);
                const carId = params.get("car");
                const pickup = params.get("pickup");
                const returnDate = params.get("return");

                if (!carId || !pickup || !returnDate) {
                    this.error = "Missing reservation data. Please start over.";
                    this.loading = false;
                    return;
                }

                const { data: { session } } = await supabase.auth.getSession();

                if (session) {
                    const { data: customer } = await supabase
                        .from("customers")
                        .select("first_name, last_name, phone, id_number, drivers_license, address")
                        .eq("id", session.user.id)
                        .single();

                    if (customer) {
                        this.form = {
                            guest_name: `${customer.first_name || ""} ${customer.last_name || ""}`.trim(),
                            guest_email: session.user.email || "",
                            guest_phone: customer.phone || "",
                            guest_id_number: customer.id_number || "",
                            guest_drivers_license: customer.drivers_license || "",
                            guest_address: customer.address || "",
                        };
                    } else {
                        this.form = {
                            guest_name: "",
                            guest_email: session.user.email || "",
                            guest_phone: "",
                            guest_id_number: "",
                            guest_drivers_license: "",
                            guest_address: "",
                        };
                    }
                    this.loading = false;
                    return;
                }

                const formRaw = localStorage.getItem("reservation_form");
                if (!formRaw) {
                    this.error = "No personal details found. Please go back and fill in your information.";
                    this.loading = false;
                    return;
                }

                this.form = JSON.parse(formRaw);
                this.loading = false;
            } catch (e) {
                console.error("Confirmation init error:", e);
                this.error = "An unexpected error occurred. Please try again.";
                this.loading = false;
            }
        },

        async confirmBooking() {
            this.submitting = true;
            this.error = "";

            try {
                const params = new URLSearchParams(window.location.search);
                const carId = params.get("car");
                const pickup = params.get("pickup");
                const returnDate = params.get("return");
                const extrasParam = params.get("extras");

                if (!carId || !pickup || !returnDate) {
                    this.error = "Missing reservation data. Please start over.";
                    this.submitting = false;
                    return;
                }

                if (!this.form?.guest_name?.trim()) {
                    this.error = "Please provide your name.";
                    this.submitting = false;
                    return;
                }

                const pickupDate = new Date(pickup);
                const returnDateObj = new Date(returnDate);

                if (isNaN(pickupDate.getTime()) || isNaN(returnDateObj.getTime())) {
                    this.error = "Invalid dates. Please go back and select valid dates.";
                    this.submitting = false;
                    return;
                }

                if (returnDateObj <= pickupDate) {
                    this.error = "Return date must be after pick-up date.";
                    this.submitting = false;
                    return;
                }

                const days = Math.max(1, Math.ceil((returnDateObj.getTime() - pickupDate.getTime()) / (1000 * 60 * 60 * 24)));

                const { data: car } = await supabase
                    .from("cars")
                    .select("daily_rate")
                    .eq("id", carId)
                    .single();

                if (!car) {
                    this.error = "Vehicle not found.";
                    this.submitting = false;
                    return;
                }

                const carTotal = car.daily_rate * days;

                let extrasTotal = 0;
                let extrasData = [];
                if (extrasParam) {
                    const ids = extrasParam.split(",").filter(Boolean);
                    if (ids.length > 0) {
                        const { data } = await supabase
                            .from("extras")
                            .select("id, price, pricing")
                            .in("id", ids);
                        extrasData = data ?? [];
                        extrasData.forEach((e) => {
                            extrasTotal += e.pricing === "per_day" ? e.price * days : e.price;
                        });
                    }
                }

                const total = carTotal + extrasTotal;

                const pickupISO = pickupDate.toISOString();
                const returnISO = returnDateObj.toISOString();

                const { data: { session } } = await supabase.auth.getSession();

                const bookingPayload: Record<string, unknown> = {
                    car_id: carId,
                    pickup_at: pickupISO,
                    dropoff_at: returnISO,
                    price: total,
                    guest_name: this.form.guest_name.trim(),
                    guest_email: this.form.guest_email || "",
                    guest_phone: this.form.guest_phone || "",
                    guest_id_number: this.form.guest_id_number || "",
                    guest_drivers_license: this.form.guest_drivers_license || "",
                    guest_address: this.form.guest_address || "",
                };

                if (session) {
                    bookingPayload.customer_id = session.user.id;
                }

                const { data: booking, error: insertError } = await supabase
                    .from("bookings")
                    .insert(bookingPayload)
                    .select()
                    .single();

                if (insertError) {
                    console.error("Booking insert error:", insertError);
                    this.error = `Failed to create reservation: ${insertError.message}`;
                    this.submitting = false;
                    return;
                }

                if (extrasData.length > 0) {
                    const bookingExtras = extrasData.map((e) => ({
                        booking_id: booking.id,
                        extra_id: e.id,
                    }));

                    const { error: extrasError } = await supabase
                        .from("booking_extras")
                        .insert(bookingExtras);

                    if (extrasError) {
                        console.error("Extras insert error:", extrasError);
                    }
                }

                this.booking = booking;
                localStorage.removeItem("reservation_form");
                this.submitting = false;
            } catch (e) {
                console.error("Confirmation error:", e);
                this.error = "An unexpected error occurred. Please try again.";
                this.submitting = false;
            }
        },
    }));
</script>
