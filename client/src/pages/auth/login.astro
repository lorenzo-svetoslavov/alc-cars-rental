---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/layouts/Header.astro";
import Footer from "@/layouts/Footer.astro";
---

<BaseLayout title="Log In · ALC Cars">
	<Header />

	<main
		class="flex-1 flex items-center justify-center bg-orange-50 px-4 py-12"
	>
		<div class="w-full max-w-md">
			<div class="card bg-white shadow-xl">
				<div class="card-body p-8">
					<div class="text-center mb-6">
						<h1 class="text-2xl font-bold text-gray-900">
							Welcome back
						</h1>
						<p class="text-gray-500 mt-1">Log in to your account</p>
					</div>

					<form id="login-form" class="flex flex-col gap-4">
						<div class="flex flex-col gap-1.5">
							<label
								for="email"
								class="font-semibold text-gray-700">Email</label
							>
							<input
								id="email"
								type="email"
								placeholder="you@email.com"
								required
								class="input input-bordered w-full border-gray-300 focus:border-orange-500 focus:outline-none"
							/>
						</div>

						<div class="flex flex-col gap-1.5">
							<label
								for="password"
								class="font-semibold text-gray-700"
								>Password</label
							>
							<input
								id="password"
								type="password"
								placeholder="••••••••"
								required
								class="input input-bordered w-full border-gray-300 focus:border-orange-500 focus:outline-none"
							/>
						</div>

						<a
							href="/auth/recuperar"
							class="text-sm font-medium text-orange-600 hover:text-orange-700 hover:underline"
						>
							Forgot your password?
						</a>

						<button
							type="submit"
							class="btn bg-orange-500 hover:bg-orange-600 text-white border-none shadow-md w-full mt-2"
						>
							Log In
						</button>
					</form>

					<div class="divider my-4 text-gray-400">or</div>

					<p class="text-center text-sm text-gray-600">
						Don't have an account?
						<a
							href="/auth/registro"
							class="font-semibold text-orange-600 hover:text-orange-700 hover:underline"
						>
							Sign up
						</a>
					</p>
				</div>
			</div>
		</div>
	</main>

	<Footer />
</BaseLayout>
