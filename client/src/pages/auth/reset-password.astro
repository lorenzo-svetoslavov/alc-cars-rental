---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/layouts/Header.astro";
import Footer from "@/layouts/Footer.astro";
---

<BaseLayout title="Set New Password · ALC Cars">
	<Header />

	<main class="flex-1 flex items-center justify-center bg-orange-50 px-4 py-12">
		<div class="w-full max-w-md">
			<div class="card bg-white shadow-xl">
				<div class="card-body p-8">
					<div class="text-center mb-6">
						<h1 class="text-2xl font-bold text-gray-900">Set New Password</h1>
						<p class="text-gray-500 mt-1">Enter your new password below</p>
					</div>

					<form x-data="resetPasswordForm()" @submit.prevent="submit()" class="flex flex-col gap-4">
						<div class="flex flex-col gap-1.5">
							<label for="password" class="font-semibold text-gray-700">New Password</label>
							<input
								id="password"
								type="password"
								placeholder="••••••••"
								required
								x-model="form.password"
								class="input input-bordered w-full border-gray-300 focus:border-orange-500 focus:outline-none"
							/>
						</div>

						<div class="flex flex-col gap-1.5">
							<label for="password-confirm" class="font-semibold text-gray-700">Confirm Password</label>
							<input
								id="password-confirm"
								type="password"
								placeholder="••••••••"
								required
								x-model="form.passwordConfirm"
								class="input input-bordered w-full border-gray-300 focus:border-orange-500 focus:outline-none"
							/>
						</div>

						<p x-show="passwordError" x-text="passwordError" x-cloak class="text-sm text-red-600"></p>
						<p x-show="error" x-text="error" x-cloak class="text-sm text-red-600"></p>

						<button
							type="submit"
							:disabled="loading"
							class="btn bg-orange-500 hover:bg-orange-600 text-white border-none shadow-md w-full mt-2"
							x-text="loading ? 'Updating...' : 'Update Password'"
						></button>
					</form>

					<div class="divider my-4 text-gray-400">or</div>

					<p class="text-center text-sm text-gray-600">
						<a href="/auth/login" class="font-semibold text-orange-600 hover:text-orange-700 hover:underline">Back to Login</a>
					</p>
				</div>
			</div>
		</div>
	</main>

	<Footer />
</BaseLayout>

<script>
	import Alpine from "alpinejs";
	import { supabase } from "@/lib/supabase";

	document.addEventListener("alpine:init", () => {
		Alpine.data("resetPasswordForm", () => ({
			form: {
				password: "",
				passwordConfirm: "",
			},
			loading: false,
			error: "",
			passwordError: "",

			async submit() {
				this.passwordError = "";
				this.error = "";

				if (this.form.password !== this.form.passwordConfirm) {
					this.passwordError = "Passwords do not match";
					return;
				}

				if (this.form.password.length < 6) {
					this.passwordError = "Password must be at least 6 characters";
					return;
				}

				this.loading = true;

				const { error } = await supabase.auth.updateUser({
					password: this.form.password,
				});

				if (error) {
					this.error = error.message;
					this.loading = false;
					return;
				}

				window.location.href = "/auth/login";
			},
		}));
	});
</script>