---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/layouts/Header.astro";
import Footer from "@/layouts/Footer.astro";
import { supabase } from "@/lib/supabase";
import type { Car } from "@/types/car";
import type { Extra } from "@/types/extra";
import { CAR_OPTIONS } from "@/types/car";

const carId = Astro.url.searchParams.get("car");
const pickup = Astro.url.searchParams.get("pickup");
const returnDate = Astro.url.searchParams.get("return");

let car: Car | null = null;
let extras: Extra[] = [];

if (carId) {
    const { data } = await supabase
        .from("cars")
        .select("*")
        .eq("id", carId)
        .single();

    car = data;
}

const { data: extrasData } = await supabase
    .from("extras")
    .select("*")
    .eq("active", true)
    .order("price");

extras = extrasData ?? [];

const baseParams = `car=${carId}&pickup=${encodeURIComponent(pickup ?? "")}&return=${encodeURIComponent(returnDate ?? "")}`;
---

<BaseLayout title="Extras · ALC Cars">
    <Header />

    <main class="max-w-2xl mx-auto px-4 py-16 flex-1 w-full">
        <header class="mb-10">
            <span class="text-xs font-semibold text-slate-400 uppercase tracking-widest">Step 2 of 4</span>
            <h1 class="text-2xl md:text-3xl font-bold text-slate-800 mt-2">
                Extras
            </h1>
            <p class="text-slate-400 mt-1 text-sm">
                Add optional services to your reservation
            </p>
        </header>

        {car && (
            <div class="mb-10">
                <h2 class="text-xs font-semibold text-slate-400 uppercase tracking-widest mb-3">Your car</h2>
                <div class="flex items-center gap-4 p-4 rounded-2xl bg-slate-50 border border-slate-100">
                    <img
                        src={car.image_url}
                        alt={`${car.make} ${car.model}`}
                        class="w-20 h-14 object-cover rounded-xl"
                    />
                    <div class="flex-1 min-w-0">
                        <p class="font-semibold text-sm text-slate-800 truncate">{car.make} {car.model} {car.model_year}</p>
                        <div class="flex items-center gap-2 mt-1.5">
                            <span class="text-xs font-semibold text-slate-500">Pickup</span>
                            <span class="text-xs font-medium text-slate-700">{pickup}</span>
                            <span class="text-slate-300 mx-0.5">·</span>
                            <span class="text-xs font-semibold text-slate-500">Dropoff</span>
                            <span class="text-xs font-medium text-slate-700">{returnDate}</span>
                        </div>
                    </div>
                    <span class="text-sm font-bold text-orange-500 shrink-0">{car.daily_rate} €<span class="font-normal text-slate-400">/day</span></span>
                </div>
            </div>
        )}

        <div>
            <h2 class="text-xs font-semibold text-slate-400 uppercase tracking-widest mb-3">Extras</h2>
            {extras.length > 0 ? (
            <div class="space-y-2" id="extras-list">
                {extras.map((extra) => (
                    <label class="extra-card flex items-center gap-4 p-4 rounded-2xl border border-slate-100 bg-white cursor-pointer transition-all hover:border-orange-200 hover:shadow-sm has-[:checked]:border-orange-400 has-[:checked]:bg-orange-50/50">
                        <input
                            type="checkbox"
                            name="extras"
                            value={extra.id}
                            data-price={extra.price}
                            data-pricing={extra.pricing}
                            class="checkbox checkbox-sm checkbox-primary border-slate-300 checked:border-orange-500 checked:bg-orange-500"
                        />
                        <div class="flex-1 min-w-0">
                            <span class="font-medium text-sm text-slate-800">{extra.name}</span>
                            <p class="text-xs text-slate-400 mt-0.5">{extra.description}</p>
                        </div>
                        <span class="text-sm font-semibold text-orange-500 shrink-0">
                            +{extra.price.toFixed(2)} €<span class="font-normal text-slate-400 text-xs"> / {extra.pricing === "per_day" ? "day" : "trip"}</span>
                        </span>
                    </label>
                ))}
            </div>
        ) : (
            <p class="text-slate-400 text-center py-12 text-sm">
                No extras available at the moment.
            </p>
        )}
        </div>

        <div class="flex justify-end mt-10">
            <a
                id="continue-btn"
                href={`/reserva/datos?${baseParams}`}
                class="btn bg-orange-500 hover:bg-orange-600 text-white border-none shadow-none"
            >
                Continue
            </a>
        </div>

        <script>
            function updateContinueLink() {
                const checked = document.querySelectorAll<HTMLInputElement>('input[name="extras"]:checked');
                const ids = Array.from(checked).map((el) => el.value);
                const btn = document.getElementById("continue-btn") as HTMLAnchorElement;
                if (!btn) return;

                const url = new URL(btn.href);
                if (ids.length > 0) {
                    url.searchParams.set("extras", ids.join(","));
                } else {
                    url.searchParams.delete("extras");
                }
                btn.href = url.toString();
            }

            document.querySelectorAll('input[name="extras"]').forEach((input) => {
                input.addEventListener("change", updateContinueLink);
            });
        </script>
    </main>

    <Footer />
</BaseLayout>
