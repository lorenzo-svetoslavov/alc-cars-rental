---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/layouts/Header.astro";
import Footer from "@/layouts/Footer.astro";
import AccountInfo from "@/components/account/AccountInfo.astro";
import BookingsCard from "@/components/account/BookingsCard.astro";
---

<BaseLayout title="My Account · ALC Cars">
	<Header />

	<main class="flex-1 bg-gray-50/50 px-4 py-10" x-data="accountPage()" x-init="init()">
		<div class="max-w-3xl mx-auto">
			<div x-show="loading" class="flex items-center justify-center py-16" x-cloak>
				<svg class="animate-spin h-6 w-6 text-orange-500" viewBox="0 0 24 24">
					<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"></circle>
					<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
				</svg>
			</div>

			<div x-show="!loading && !user" class="text-center py-16" x-cloak>
				<svg class="w-10 h-10 text-gray-300 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
				</svg>
				<h2 class="text-base font-semibold text-gray-900 mb-1">Please log in</h2>
				<p class="text-sm text-gray-500 mb-5">You need to be logged in to access your account.</p>
				<a href="/auth/login" class="btn btn-sm bg-orange-500 hover:bg-orange-600 text-white border-none">Log In</a>
			</div>

			<div x-show="!loading && user" class="flex flex-col gap-4" x-cloak>
				<AccountInfo />
				<BookingsCard />
			</div>
		</div>
	</main>

	<Footer />
</BaseLayout>

<script>
	import Alpine from "alpinejs";
	import { supabase } from "@/lib/supabase";

	document.addEventListener("alpine:init", () => {
		Alpine.data("accountPage", () => ({
			user: null,
			loading: true,

			async init() {
				const { data: { session } } = await supabase.auth.getSession();
				if (!session) {
					this.loading = false;
					return;
				}
				this.user = session.user;

				supabase.auth.onAuthStateChange((_event, session) => {
					this.user = session?.user || null;
					this.loading = false;
				});
			},
		}));
	});
</script>